#!/bin/bash

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)}"
DOCS_OUTPUT_ROOT="${DOCS_OUTPUT_ROOT:-$REPO_ROOT/.build/docc-site}"
OUTPUT_PATH="${DOCS_OUTPUT_PATH:-$DOCS_OUTPUT_ROOT/WidgetGuideView}"
HOSTING_BASE_PATH="${HOSTING_BASE_PATH:-${DOCS_HOSTING_BASE_PATH:-WidgetGuideView}}"
IOS_SIMULATOR_SDK="${IOS_SIMULATOR_SDK:-$(xcrun --sdk iphonesimulator --show-sdk-path)}"
IOS_SIMULATOR_TARGET="${IOS_SIMULATOR_TARGET:-$(uname -m)-apple-ios13.0-simulator}"

case "$OUTPUT_PATH" in
  /*) ;;
  *) OUTPUT_PATH="$REPO_ROOT/$OUTPUT_PATH" ;;
esac

mkdir -p "$DOCS_OUTPUT_ROOT"
mkdir -p "$(dirname "$OUTPUT_PATH")"

DOCS_OUTPUT_ROOT="$(cd "$DOCS_OUTPUT_ROOT" && pwd -P)"
OUTPUT_PATH="$(cd "$(dirname "$OUTPUT_PATH")" && pwd -P)/$(basename "$OUTPUT_PATH")"

case "$OUTPUT_PATH" in
  "$DOCS_OUTPUT_ROOT"/*) ;;
  *)
    echo "Refusing to delete output path outside $DOCS_OUTPUT_ROOT: $OUTPUT_PATH" >&2
    exit 1
    ;;
esac

rm -rf "$OUTPUT_PATH"
mkdir -p "$(dirname "$OUTPUT_PATH")"

swift package \
  --sdk "$IOS_SIMULATOR_SDK" \
  --triple "$IOS_SIMULATOR_TARGET" \
  --allow-writing-to-directory "$OUTPUT_PATH" \
  generate-documentation \
  --target WidgetGuideView \
  --disable-indexing \
  --output-path "$OUTPUT_PATH" \
  --transform-for-static-hosting \
  --hosting-base-path "$HOSTING_BASE_PATH"

HOSTING_BASE_PATH="/${HOSTING_BASE_PATH#/}"
export HOSTING_BASE_PATH
perl -0pi -e '
  my $base = $ENV{"HOSTING_BASE_PATH"};
  s#href="/favicon\.ico"#href="$base/favicon.ico"#g;
  s#href="/favicon\.svg"#href="$base/favicon.svg"#g;
  s#var baseUrl = "/"#var baseUrl = "$base/"#g;
  s#src="/js/#src="$base/js/#g;
  s#href="/css/#href="$base/css/#g;
' "$OUTPUT_PATH/index.html"

rm -rf ./docs
rm -rf ./WidgetGuideView.doccarchive
